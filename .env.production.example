# Copy to .env.production on the server and replace every placeholder.
# Use a URL-safe hex password: openssl rand -hex 24
API_HOST=api.hopiumstudio.com
API_URL=https://api.hopiumstudio.com
PUBLIC_SITE_HOSTS=hopiumstudio.com, www.hopiumstudio.com
SITE_ROOT=../site
PORT=8787
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_PASSWORD
DATABASE_URL=postgres://instamail:REPLACE_WITH_URL_SAFE_PASSWORD@postgres:5432/instamail
REDIS_URL=redis://redis:6379
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
EXTENSION_ID=REPLACE_WITH_STABLE_EXTENSION_ID
TOKEN_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
PUBSUB_TOPIC=projects/pragmatic-armor-514309-t6/topics/instamail-gmail-events
PUBSUB_SUBSCRIPTION=projects/pragmatic-armor-514309-t6/subscriptions/instamail-gmail-push
PUSH_IDENTITY=instamail-push@pragmatic-armor-514309-t6.iam.gserviceaccount.com
PUSH_AUDIENCE=https://api.hopiumstudio.com/internal/pubsub/gmail
SCHEDULER_IDENTITY=instamail-scheduler@pragmatic-armor-514309-t6.iam.gserviceaccount.com
SITE_URL=https://www.hopiumstudio.com
