{
  "name": "instamail",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "icons": "node scripts/icons.mjs",
    "pack:deploy": "node scripts/pack-deploy.mjs",
    "dev": "tsx watch apps/api/server.ts",
    "test": "node --import tsx --test packages/detector/*.test.ts",
    "typecheck": "tsc --noEmit",
    "watch:renew:local": "node --env-file=.env --import tsx scripts/renew-watches-local.ts",
    "production:check": "node scripts/check-production.mjs",
    "legal:init": "node scripts/init-legal-env.mjs",
    "legal:check": "node scripts/check-legal.mjs",
    "release:build": "node scripts/check-legal.mjs && node scripts/check-production.mjs && node --import tsx scripts/build.ts",
    "pilot:env": "node scripts/prepare-pilot-env.mjs",
    "extension:zip": "cd apps/extension/dist && zip -qr ../../../InstaMail-extension.zip .",
    "site:pack": "node scripts/deploy-site-pack.mjs",
    "site:verify": "node scripts/verify-live-site.mjs",
    "site:preflight": "node scripts/preflight-site-upload.mjs",
    "site:deploy-vps": "node scripts/deploy-site-vps.mjs",
    "site:deploy-hostinger": "node scripts/preflight-site-upload.mjs && node scripts/deploy-site-hostinger.mjs",
    "launch:readiness": "node scripts/launch-readiness.mjs",
    "launch:resume": "node scripts/launch-readiness.mjs",
    "store:ready": "node scripts/store-ready.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "google-auth-library": "^10.5.0",
    "marked": "^17.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.9.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
