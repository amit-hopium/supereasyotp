# Copy to build-pack/legal.env (gitignored), fill every value, then: pnpm legal:check && pnpm build
# Bracket names match placeholders in build-pack/*.md and the static site footer.

LEGAL_OPERATOR_NAME=REPLACE_Your legal entity name
BUSINESS_OR_CONTACT_ADDRESS=REPLACE_Registered or contact address
SUPPORT_EMAIL=amit@hopiumstudio.com
PRIVACY_EMAIL=amit@hopiumstudio.com
SECURITY_EMAIL=amit@hopiumstudio.com
PUBLIC_DOMAIN=https://supereasyotp.com
API_DOMAIN=api.hopiumstudio.com
# Use a real CWS URL after upload, or temporarily https://supereasyotps.com/#availability until then
CHROME_STORE_URL=https://supereasyotp.com/#availability
# Optional: public source repo (homepage + security page)
# SOURCE_REPO_URL=https://github.com/your-org/supereasyotp
SOCIAL_X_URL=https://x.com/studiohopium
EFFECTIVE_DATE=2026-12-01
GOVERNING_JURISDICTION=REPLACE_e.g. India
HOSTING_REGION=REPLACE_e.g. VPS region (India)
INFRASTRUCTURE_PROVIDERS=Google Cloud (Pub/Sub, OAuth); Hostinger VPS; PostgreSQL and Redis on same host
# Optional: demo video on /docs (YouTube/Vimeo embed URL, or a direct .mp4/.webm link). Leave unset for the placeholder.
# DEMO_VIDEO_URL=https://www.youtube.com/embed/VIDEO_ID
